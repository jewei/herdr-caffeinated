# Copy to: $(herdr plugin config-dir herdr-caffeinated)/config
# key = value lines. Unknown keys and invalid values are ignored and logged.

# caffeinate(8) flags: a dash and letters from "dimsu".
# Add "d" to keep the display on.
caffeinate_flags = -ims

# Seconds to stay awake after the last agent stops working.
idle_grace_seconds = 60

# Comma list of agent statuses that keep the Mac awake.
awake_statuses = working
