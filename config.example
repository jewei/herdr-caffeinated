# Copy this file to the directory that this command prints:
#   herdr plugin config-dir herdr-caffeinated
# Name the copy "config". Each line is "key = value".
# The plugin ignores an unknown key or an invalid value and logs it.

# The flags that the plugin passes to caffeinate(8). Use a dash and letters
# from "dimsu". The "d" flag keeps the display on.
caffeinate_flags = -ims

# The number of seconds that the Mac stays awake after the last agent stops
# work.
idle_grace_seconds = 60

# A comma list of the agent statuses that keep the Mac awake. Herdr reports
# "idle", "working", "blocked", "done", and "unknown".
awake_statuses = working

# The number of seconds between two watchdog checks. The value 0 turns the
# watchdog off.
watchdog_seconds = 30
